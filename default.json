{
  "extends": [
    "config:base",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Auto-merge every non-major dependency update once checks pass, for every manager (GitHub Actions, npm, Docker, digests), not only Go modules. Majors stay manual. Later rules in this list still opt specific updates out.",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "go toolchain",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "automerge": false
    },
    {
      "groupName": "go toolchain patches",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "3d-parties non major deps",
      "groupSlug": "3d-parties-minor-patch-pin",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin"
      ],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
